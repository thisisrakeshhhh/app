<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all secure token storage and credentials from cloud backups -->
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".routeflow_secure_session" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude credentials from adb backup and device-to-device transfers -->
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path=".routeflow_secure_session" />
    </device-transfer>
</data-extraction-rules>
